{
// sourced from header module //

  "layer": "top",
  "position": "top",
  "height": 32,
  "exclusive": true,
  "passthrough": false,


  // Each group is drawn as one rounded pill (style.css)
  "modules-left": [
    "custom/appmenu",
    "wlr/taskbar"
  ],

  "modules-center": [
    "hyprland/workspaces"
  ],

  "modules-right": [
    "tray",
    "group/system",
    "group/session"
  ],

  "group/system": {
    "orientation": "inherit",
    "modules": [
      "power-profiles-daemon",
      "custom/luminance",
      "battery",
      "network",
      "bluetooth",
      "pulseaudio"
    ]
  },

  "group/session": {
    "orientation": "inherit",
    "modules": [
      "custom/notification",
      "clock",
      "custom/power"
    ]
  },

  // Load Modules
  "include": ["~/.config/waybar/modules.json"],
}

