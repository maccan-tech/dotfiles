{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 5,
  "control-center-margin-bottom": 0,
  "control-center-margin-right": 0,
  "control-center-margin-left": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-icon-size": 24,
  "notification-body-image-height": 100,
  "notification-body-image-width": 100,
  "notification-window-width": 300,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "control-center-width": 450,
  "control-center-height": 720,
  "keyboard-shortcuts": true,
  "image-visibility": "when available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": false,
  "scripts": {
    "play-sound": {
      "exec": "~/.config/swaync/scripts/notify_sound.sh",
      "app-name": ".*",
      "run-on": "receive"
    }
  },
  "widgets": [
      "buttons-grid",
      "mpris",
      "volume",
      "backlight",
      "dnd",
      "title",
      "notifications"
  ],
  "widget-config": {
      "title": {
          "text": "Notifications",
          "clear-all-button": true,
          "button-text": "Clear"
      },
      "dnd": {
          "text": "Do Not Disturb"
      },
      "label": {
          "max-lines": 1,
          "text": "Notification"
      },
      "mpris": {
          "image-size": 10,
          "image-radius": 0
      },
      "volume": {
          "label": "󰕾"
      },
      "backlight": {
          "label": "󰃟"
      },
      "buttons-grid": {
          "buttons-per-row": 3,
          "actions": [
              {
                "label": "󰐥",
                "tooltip": "Power menu",
                "command": "~/.config/wlogout/logoutlaunch.sh 2"
              },
              {
                "label": "󰌾",
                "tooltip": "Lock screen",
                "command": "bash -c hyprlock"
              },
              {
                "label": "󰍃",
                "tooltip": "Logout",
                "command": "hyprctl dispatch exit"
              },
              {
                "label": "",
                "type": "toggle",
                "active": true,
                "command": "sh -c '~/.config/swaync/scripts/toggle_wifi.sh'",
                "update-command": "sh -c 'set +e;[[ $(nmcli radio wifi) == \"enabled\" ]] && echo true || echo false'"
              },
              {
                "label": "󰂯",
                "type": "toggle",
                "active": true,
                "command": "sh -c '~/.config/swaync/scripts/toggle_bluetooth.sh'",
                "update-command": "sh -c 'set +e;bluetoothctl show | grep -qF Powered:\\ yes && echo true || echo false'"
              },
              {
                "label": "󰀝",
                "tooltip": "Airplane mode",
                "command": "bash -c $HOME/.config/hypr/scripts/AirplaneMode.sh"
              },
              {
                "label": "󰝟",
                "tooltip": "Toggle mute",
                "type": "toggle",
                "active": true,
                "command": "swayosd-client --output-volume mute-toggle",
                "update-command": "sh -c 'pactl get-sink-mute @DEFAULT_SINK@ | grep -q \"Mute: yes\" && echo true || echo false'"
              }
         ]
      }
  }
}
