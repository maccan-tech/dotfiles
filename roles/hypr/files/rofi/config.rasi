@theme "~/.config/rofi/shared.rasi"

/* App launcher (rofi -show drun, Alt+Space). Look comes from shared.rasi. */

configuration {
    show-icons:          true;
    icon-theme:          "Papirus";
    location:            0;
    font:                "JetBrainsMono Nerd Font 12";
    display-drun:        "Launch";
    drun-display-format: "{name}[ <span size='small' foreground='#6B6460'>{generic}</span>]";
}

window {
    width: 35%;
}

listview {
    columns:       2;
    lines:         9;
    fixed-height:  true;
    fixed-columns: true;
}

element {
    orientation: horizontal;
}

element-icon {
    size: 22px;
}

element-text {
    markup: true;
}
