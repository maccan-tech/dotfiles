@theme "~/.config/rofi/shared.rasi"

/* Single column text menus: keybindings (Alt+Shift+K), screenshot (Alt+P),
   brightness. Look comes from shared.rasi. */

configuration {
    show-icons: false;
    location:   0;
    font:       "JetBrainsMono Nerd Font 12";
}

window {
    width: 35%;
}

listview {
    columns:      1;
    lines:        9;
    fixed-height: false;
    dynamic:      true;
}
