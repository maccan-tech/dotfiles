@theme "~/.config/rofi/shared.rasi"

/* Wallpaper picker (hypr/scripts/wallpaper-grid.sh, Alt+W): grid of square
   thumbnails. Look comes from shared.rasi; the current wallpaper is the
   "active" row, marked with a subtle frame. */

configuration {
    show-icons: true;
    location:   0;
}

window {
    width: 1360px;
}

listview {
    columns:       5;
    lines:         2;
    spacing:       12px;
    fixed-height:  true;
    fixed-columns: true;
    cycle:         false;
    flow:          horizontal;
}

element {
    orientation:   vertical;
    spacing:       8px;
    padding:       8px;
    border:        3px;
    border-radius: 12px;
}

element-icon {
    size:             240px;
    border-radius:    8px;
    horizontal-align: 0.5;
}

element-text {
    font:             "JetBrainsMono Nerd Font 10";
    horizontal-align: 0.5;
}

/* Unselected names are dimmed so the thumbnails stand out */
element normal.normal, element alternate.normal {
    text-color: @cmt;
}
