@theme "~/.config/rofi/themes/nordic-mist.rasi"

/* Wallpaper picker (hypr/scripts/wallpaper-grid.sh): grid of square
   thumbnails. The highlighted card gets a green frame instead of a filled
   background, and the current wallpaper is marked with a subtle frame. */

configuration {
    show-icons: true;
    location:   0;
}

window {
    width:            1360px;
    border-radius:    12px;
    padding:          12px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing:  12px;
    padding:  0px;
}

inputbar {
    children:         [ prompt, entry ];
    spacing:          10px;
    padding:          10px 14px;
    border-radius:    8px;
    background-color: @cur;
}

prompt {
    text-color:       @grn;
    background-color: transparent;
}

entry {
    placeholder:       "Search...";
    placeholder-color: @cmt;
    background-color:  transparent;
}

listview {
    columns:      5;
    lines:        2;
    border:       0px;
    spacing:      12px;
    padding:      0px;
    fixed-height: true;
    fixed-columns: true;
    cycle:        false;
    flow:         horizontal;
}

element {
    orientation:      vertical;
    spacing:          8px;
    padding:          8px;
    border:           3px;
    border-radius:    12px;
    border-color:     transparent;
    background-color: @bg;
    cursor:           pointer;
}

element-icon {
    size:             240px;
    border-radius:    8px;
    background-color: transparent;
    horizontal-align: 0.5;
}

element-text {
    font:             "JetBrainsMono Nerd Font 10";
    horizontal-align: 0.5;
    background-color: transparent;
    text-color:       inherit;
}

/* Override the filled highlight from the theme */
element normal.normal, element alternate.normal {
    background-color: @bg;
    text-color:       @cmt;
}

element selected.normal {
    background-color: @cur;
    border-color:     @grn;
    text-color:       @fgd;
}

/* Current wallpaper */
element normal.active, element alternate.active {
    background-color: @bg;
    border-color:     @cmt;
    text-color:       @fgd;
}

element selected.active {
    background-color: @cur;
    border-color:     @grn;
    text-color:       @grn;
}
